{
  "name": "desk",
  "listen": "100.64.0.1:8796",
  "every": 10,
  "keep": 360,
  "disks": ["/", "/home"],

  "panels": [
    { "id": "load", "title": "load · 1 min", "kind": "series", "builtin": "load", "every": 30 },
    { "id": "root", "title": "disk /", "kind": "stat", "builtin": "disk:/", "unit": "%", "max": 100 },
    {
      "id": "failed",
      "title": "failed units",
      "kind": "list",
      "command": "systemctl --user --failed --no-legend --plain | awk '{print $1}'",
      "every": 120
    },
    {
      "id": "biggest",
      "title": "biggest processes",
      "kind": "table",
      "command": "ps -eo comm,%cpu,%mem --sort=-%cpu --no-headers | head -8",
      "headers": ["process", "cpu %", "mem %"],
      "every": 30
    }
  ],

  "services": [
    {
      "id": "site",
      "name": "website",
      "about": "the dev server behind the portfolio",
      "process": { "match": "vite", "cwd": "~/code/site" },
      "url": "https://site.example.ts.net",
      "health": { "http": "http://127.0.0.1:5173/", "every": 30 },
      "logs": { "file": "~/code/site/dev.log" },
      "actions": [
        { "id": "start", "label": "start", "command": "cd ~/code/site && nohup npm run dev -- --host > dev.log 2>&1 &" }
      ],
      "panels": [
        {
          "id": "build",
          "title": "last build",
          "kind": "stat",
          "command": "stat -c %Y ~/code/site/dist/index.html",
          "display": "ago",
          "every": 300
        }
      ]
    },
    {
      "id": "watcher",
      "name": "page watcher",
      "about": "a Go service with a JSON status API",
      "systemd": { "unit": "watcher.service", "user": true },
      "health": { "http": "http://127.0.0.1:8478/", "every": 30 },
      "actions": [
        "restart",
        "stop",
        "start",
        {
          "id": "check",
          "label": "check now",
          "http": {
            "method": "POST",
            "url": "http://127.0.0.1:8478/api/check/all",
            "headers": { "Authorization": "Bearer ${json:~/code/watcher/secrets.json#auth_token}" }
          }
        }
      ],
      "panels": [
        {
          "id": "watchers",
          "title": "watchers",
          "kind": "stat",
          "http": {
            "url": "http://127.0.0.1:8478/api/status",
            "headers": { "Authorization": "Bearer ${json:~/code/watcher/secrets.json#auth_token}" }
          },
          "path": "watchers.*",
          "reduce": "count"
        },
        {
          "id": "failing",
          "title": "failing",
          "kind": "series",
          "http": {
            "url": "http://127.0.0.1:8478/api/status",
            "headers": { "Authorization": "Bearer ${json:~/code/watcher/secrets.json#auth_token}" }
          },
          "path": "watchers.*",
          "where": { "last_status": "!ok" },
          "reduce": "count",
          "every": 60
        },
        {
          "id": "by-status",
          "title": "by last status",
          "kind": "bars",
          "http": {
            "url": "http://127.0.0.1:8478/api/status",
            "headers": { "Authorization": "Bearer ${json:~/code/watcher/secrets.json#auth_token}" }
          },
          "path": "watchers.*",
          "group": "last_status"
        },
        {
          "id": "events",
          "title": "recent",
          "kind": "table",
          "http": {
            "url": "http://127.0.0.1:8478/api/events?limit=20",
            "headers": { "Authorization": "Bearer ${json:~/code/watcher/secrets.json#auth_token}" }
          },
          "columns": [
            { "label": "when", "path": "ts", "format": "ago" },
            { "label": "watcher", "path": "watcher" },
            { "label": "what", "path": "detail" }
          ],
          "limit": 20
        }
      ]
    }
  ]
}
